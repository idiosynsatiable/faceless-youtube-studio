# Database + queue
DATABASE_URL=postgresql://faceless:faceless@postgres:5432/faceless_studio
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_me_with_secure_local_secret
OPERATOR_EMAIL=operator@faceless-studio.local

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video worker shared volumes
WORKER_INPUT_ALLOWLIST=/var/lib/faceless-studio/inputs
WORKER_OUTPUT_ROOT=/var/lib/faceless-studio/exports
FFMPEG_BINARY=/usr/bin/ffmpeg
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_MS=900000

# Stripe (leave empty to run in disabled-safe mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# YouTube OAuth (required for publishing and channel identity verification)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_TARGET_HANDLE=@idiosynsatiable
YOUTUBE_TARGET_CHANNEL_ID=

# Encryption key used for stored YouTube refresh tokens when OAuth is enabled
OAUTH_TOKEN_ENCRYPTION_KEY=

# OpenAI media + reasoning
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_AUTONOMY_MODEL=gpt-5.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=onyx
OPENAI_VIDEO_MODEL=sora-2-pro

# Owner-controlled production policy. Keep disabled/private until OAuth, secrets,
# shared storage, controller and worker verification are complete.
AUTONOMY_ENABLED=false
AUTONOMY_PUBLISH_MODE=private
AUTONOMY_INTERVAL_MINUTES=60
AUTONOMY_MAX_UPLOADS_PER_DAY=2
AUTONOMY_MIN_HOURS_BETWEEN_UPLOADS=6
AUTONOMY_MIN_OPPORTUNITY_SCORE=72
AUTONOMY_MIN_SOURCE_COUNT=2
AUTONOMY_MIN_CONFIDENCE=75
AUTONOMY_MAX_VISUALS=6
AUTONOMY_SHORTS_PER_VIDEO=2
AUTONOMY_UPLOAD_SHORTS=true
AUTONOMY_SHORTS_SPACING_HOURS=6
AUTONOMY_SORA_ENABLED=false
AUTONOMY_MAX_SORA_CLIPS=1
