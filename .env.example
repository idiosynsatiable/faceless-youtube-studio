# Database + queue
DATABASE_URL=postgresql://faceless:faceless@postgres:5432/faceless_studio
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_me_with_secure_local_secret
# Independent HMAC secret used to sign the short-lived OAuth state parameter.
# Generate a unique high-entropy value in production; do not reuse the default JWT secret.
OAUTH_STATE_SECRET=
OPERATOR_EMAIL=operator@faceless-studio.local

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video worker shared volumes
WORKER_INPUT_ALLOWLIST=/var/lib/faceless-studio/inputs
WORKER_OUTPUT_ROOT=/var/lib/faceless-studio/exports
FFMPEG_BINARY=/usr/bin/ffmpeg
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_MS=900000

# Stripe (leave empty to run in disabled-safe mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# YouTube OAuth (optional for rendering; required only for publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# Required owner lock. The callback resolves this public handle to its immutable
# channel ID and refuses to store credentials for any other account.
YOUTUBE_AUTHORIZED_CHANNEL_HANDLE=idiosynsatiable
# Optional explicit immutable lock after the first successful owner authorization.
# Set this to the verified channel ID shown by the OAuth connection result.
YOUTUBE_AUTHORIZED_CHANNEL_ID=

# Encryption key used for stored YouTube refresh tokens when OAuth is enabled
OAUTH_TOKEN_ENCRYPTION_KEY=

# AI provider (optional; engines run rule-based when unset)
OPENAI_API_KEY=
AI_PROVIDER=openai
